# ============================================================
# deploy/Caddyfile —— 放在应用前面的 HTTPS 反向代理
#
# 用之前先替换两处：
#   1. quant.duckdns.org  → 你自己的 DDNS 域名
#   2. you@example.com    → 你的邮箱（证书到期提醒用）
#
# 证书签发二选一：
#   A. 运营商没封 80 端口（首选，最省事）：删掉下面 tls { dns duckdns } 整块，
#      Caddy 会自动走 HTTP-01 向 Let's Encrypt 申请证书。
#   B. 80 端口不通（很多家宽如此）：保留 tls { dns duckdns }，走 DNS-01，
#      不需要开放任何入站端口做验证。此时要用带 duckdns 插件的 Caddy 构建，
#      见 deploy/setup_caddy.ps1。
#
# 启动：  caddy run --config deploy/Caddyfile
# ============================================================

{
	email you@example.com

	log {
		output file ../logs/caddy.log
		level WARN
	}
}

quant.duckdns.org {
	encode gzip

	# ---- B. DNS-01 模式：80 端口不通时保留（A 模式请整块删除）----
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}
	# -------------------------------------------------------------

	# 安全头（应用层已经加过一份，这里是第二层）
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# 应用只监听 127.0.0.1，外面直接摸不到
	reverse_proxy 127.0.0.1:8772 {
		flush_interval -1
	}

	# 可选：只放行自己的 IP（手机流量 IP 会变，按需开）
	# @blocked not remote_ip 1.2.3.4 203.0.113.0/24
	# respond @blocked 403
}

# 说明：Caddy 默认自动把 80 端口的 HTTP 请求 308 跳到 HTTPS，
# 并用它完成 HTTP-01 验证，所以不用手写重定向块。
# 若 80 端口被别的程序（IIS / Apache / 迅雷）占用导致 Caddy 起不来：
#   在全局块里加  auto_https disable_redirects  或直接停掉占用程序。
